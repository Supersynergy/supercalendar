# Shared event store. Defaults to a local SQLite file (cross-device when the app
# runs on a single server). For cloud sync across servers, point these at a
# libSQL/Turso database.
DATABASE_URL="file:./data/supercalendar.db"
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-token"
