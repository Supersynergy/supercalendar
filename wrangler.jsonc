{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supercalendar",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  // Turso/libSQL connection. DATABASE_URL may live here; the auth token MUST be a
  // secret: `wrangler secret put DATABASE_AUTH_TOKEN`. Leave both unset to fall
  // back to the bundled file store (NOT persistent on Workers — set Turso).
  "vars": {
    // "DATABASE_URL": "libsql://your-db.turso.io"
  }
}
