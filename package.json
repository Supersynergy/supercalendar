{
  "name": "supercalendar",
  "version": "2.0.1",
  "private": false,
  "description": "SuperCalendar — a feature-rich, high-performance calendar for Next.js. A SuperSynergy fork of big-calendar by Leonardo Ramos.",
  "license": "MIT",
  "author": "SuperSynergy",
  "homepage": "https://github.com/Supersynergy/supercalendar",
  "repository": {
    "type": "git",
    "url": "https://github.com/Supersynergy/supercalendar.git"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "postcss": "^8.5.10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview:shots": "bun scripts/screenshots.ts",
    "turbo": "next dev --turbo",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && wrangler deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@hookform/resolvers": "^5.0.1",
    "@libsql/client": "^0.17.3",
    "@radix-ui/react-accordion": "^1.2.7",
    "@radix-ui/react-avatar": "^1.1.6",
    "@radix-ui/react-dialog": "^1.1.10",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.10",
    "@radix-ui/react-scroll-area": "^1.2.5",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.2.3",
    "@vercel/analytics": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.488.0",
    "next": "^16.2.6",
    "react": "^19.2.0",
    "react-aria-components": "^1.6.0",
    "react-day-picker": "^9.7.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.55.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@opennextjs/cloudflare": "^1.19.11",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.5.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.101.0"
  }
}
